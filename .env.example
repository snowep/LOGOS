# LOGOS Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# System paths
LOGOS_HOME=~/.logos
LOGOS_WORKSPACE_ROOT=

# Backend API
LOGOS_API_URL=http://127.0.0.1:3001
PORT=3001
HOST=127.0.0.1

# Model Provider (replaceable ModelProvider interface)
LOGOS_MODEL_PROVIDER=nemotron
LOGOS_MODEL_BASE_URL=https://api.nvidia.com/v1
LOGOS_MODEL_NAME=nemotron-3-ultra

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend - prefer same-origin /api/* paths in browser
NEXT_PUBLIC_API_URL=