# LOGOS Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the real .env file

# System paths
ORION_HOME=~/.logos
ORION_WORKSPACE_ROOT=D:\Project\LOGOS\vault

# Backend API
ORION_API_URL=http://localhost:4000
PORT=4000

# Model Provider (Nemotron via replaceable ModelProvider interface)
ORION_MODEL_PROVIDER=nemotron
ORION_MODEL_BASE_URL=https://api.nvidia.com/v1
ORION_MODEL_NAME=nemotron-3-ultra

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Frontend
VITE_API_URL=http://localhost:4000