/// Prisma schema for LOGOS
/// SQLite provider for local-first development

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./storage/system/logos.db"
}

enum MemoryState {
  SHORT_TERM
  CANDIDATE
  DURABLE
  SUPERSEDED
  EXPIRED
  FORGOTTEN
}

enum TaskStatus {
  BACKLOG
  PLANNED
  WAITING_APPROVAL
  READY
  RUNNING
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ArtifactType {
  FILE
  DESIGN
  CODE_PATCH
  REPORT
  EXPORT
  COUNCIL_SESSION_RECORD
}

enum ConflictState {
  DETECTED
  RESOLVED
  IGNORED
}

model User {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String?
  email         String?  @unique
  workspace     Workspace[] @relation("WorkspaceUser")
  projects      Project[] @relation("ProjectOwner")
  conversations Conversation[] @relation("ConversationParticipant")
  memories      Memory[] @relation("MemoryOwner")
  decisions     Decision[] @relation("DecisionParticipants")
  tasks         Task[] @relation("TaskAssignee")
  artifacts     Artifact[] @relation("ArtifactOwner")
  approvals     Approval[] @relation("ApprovalUser")
  notifications Notification[] @relation("NotificationUser")
}

model Workspace {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  slug          String   @unique
  description   String?
  owner         User     @relation("WorkspaceUser", fields: [ownerId], references: [id])
  ownerId       String
  projects      Project[] @relation("WorkspaceProjects")
  conversations Conversation[] @relation("WorkspaceConversations")
  memories      Memory[] @relation("WorkspaceMemories")
  decisions     Decision[] @relation("WorkspaceDecisions")
}

/// Core domain models

model Project {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  slug          String   @unique
  description   String?
  goal          String?
  status        String   @default("active") // active, archived, completed
  owner         User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  ownerId       String
  workspace     Workspace? @relation("WorkspaceProjects", fields: [workspaceId], references: [id])
  workspaceId   String?
  conversations Conversation[] @relation("ProjectConversations")
  tasks         Task[] @relation("ProjectTasks")
  decisions     Decision[] @relation("ProjectDecisions")
  artifacts     Artifact[] @relation("ProjectArtifacts")
  memories      Memory[] @relation("ProjectMemories")
  experience    Experience[] @relation("ProjectExperience")
  persons       Person[] @relation("ProjectPersons")
  personas      Persona[] @relation("ProjectPersonas")
  councils      Council[] @relation("ProjectCouncils")
  sources       Source[] @relation("ProjectSources")
  events        Event[] @relation("ProjectEvents")
}

model Conversation {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  title         String?
  workspace     Workspace? @relation("WorkspaceConversations", fields: [workspaceId], references: [id])
  workspaceId   String?
  project       Project? @relation("ProjectConversations", fields: [projectId], references: [id])
  projectId     String?
  participants  User[] @relation("ConversationParticipant")
  messages      Message[] @relation("ConversationMessages")
  tasks         Task[] @relation("ConversationTasks")
  decisions     Decision[] @relation("ConversationDecisions")
  sources       Source[] @relation("ConversationSources")
}

model Message {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  conversation  Conversation @relation("ConversationMessages", fields: [conversationId], references: [id])
  conversationId String
  senderType    String   // user, orion, persona, system
  senderId      String   // references User.id, orion system, Persona.id, etc.
  content       String
  metadata      Json?
}

model Memory {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  content       String
  type          String   // fact, opinion, decision, assumption, preference, goal, experience, observation, relationship, instruction
  scope         String   // personal, project, workspace, global
  state         MemoryState @default(SHORT_TERM)
  confidence    Float    @default(1.0)
  importance    Int      @default(1) // 1-5 scale
  sourceId      String?  // references Source.id
  projectId     String?  // references Project.id
  personaId     String?  // references Persona.id
  councilId     String?  // references Council.id
  supersedes    String?  // references Memory.id (the memory this supersedes)
  workspace     Workspace? @relation("WorkspaceMemories", fields: [workspaceId], references: [id])
  workspaceId   String?
  project       Project? @relation("ProjectMemories", fields: [projectId], references: [id])
  persona       Persona? @relation("PersonaMemories", fields: [personaId], references: [id])
  council       Council? @relation("CouncilMemories", fields: [councilId], references: [id])
  source        Source?  @relation("MemorySource", fields: [sourceId], references: [id])
}

model Knowledge {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  title         String
  content       String
  type          String   // fact, procedure, principle, etc.
  sourceId      String?  // references Source.id
  projectId     String?  // references Project.id
  personaId     String?  // references Persona.id
  workspace     Workspace? @relation("WorkspaceKnowledge", fields: [workspaceId], references: [id])
  workspaceId   String?
  project       Project? @relation("ProjectKnowledge", fields: [projectId], references: [id])
  persona       Persona? @relation("PersonaKnowledge", fields: [personaId], references: [id])
  source        Source?  @relation("KnowledgeSource", fields: [sourceId], references: [id])
}

model Experience {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  whatHappened  String
  whatWasAttempted String?
  whatResultOccurred String?
  whatWasLearned String?
  whereLessonApplies String?
  projectId     String?  // references Project.id
  project       Project? @relation("ProjectExperience", fields: [projectId], references: [id])
}

model Source {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  type          String   // conversation, file, web, database, council, user, external-service
  title         String
  locator       String   // URL, file path, DB query, etc.
  retrievedAt   DateTime @default(now())
  hashOrVersion String?  // for versioning
  workspace     Workspace? @relation("WorkspaceSources", fields: [workspaceId], references: [id])
  workspaceId   String?
  project       Project? @relation("ProjectSources", fields: [projectId], references: [id])
  conversation  Conversation? @relation("ConversationSources", fields: [conversationId], references: [id])
  user          User?    @relation("UserSource", fields: [userId], references: [id])
  userId        String?
}

model Person {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  email         String?
  workspace     Workspace? @relation("WorkspacePersons", fields: [workspaceId], references: [id])
  workspaceId   String?
  project       Project? @relation("ProjectPersons", fields: [projectId], references: [id])
  projectId     String?
}

model Persona {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  description   String?
  role          String   // e.g., "Research Specialist", "Financial Analyst"
  personality   String?  // brief description of traits
  expertise     String[] // areas of expertise
  instructions  String   // system prompt for this persona
  capabilities  String[] // specific capabilities (e.g., ["file_analysis", "data_visualization"])
  knowledgeSources String[] // IDs of knowledge sources this persona has access to
  memoryScope   String   // scope of memory this persona can access (personal, project, global)
  workspace     Workspace? @relation("WorkspacePersonas", fields: [workspaceId], references: [id])
  workspaceId   String?
  project       Project? @relation("ProjectPersonas", fields: [projectId], references: [id])
  projectId     String?
  memories      Memory[] @relation("PersonaMemories")
  councils      Council[] @relation("PersonaCouncils")
}

model Manager {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  description   String?
  managedDomain String   // e.g., "Vault", "Memory", "Project", "Knowledge"
  monitoringRules Json?   // JSON object defining what to monitor
  allowedCapabilities String[] // capabilities this manager is allowed to use
  offlineExecutionPolicy String @default("No unattended execution while user is offline.")
  persona       Persona @relation("ManagerPersona", fields: [personaId], references: [id])
  personaId     String
  workspace     Workspace? @relation("WorkspaceManagers", fields: [workspaceId], references: [id])
  workspaceId   String?
  project       Project? @relation("ProjectManagers", fields: [projectId], references: [id])
  projectId     String?
}

model Council {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String
  type          String   // permanent or rotating
  purpose       String
  rules         String?  // council-specific rules
  chairPolicy   String?  // how chair is selected/rotated
  active        Boolean  @default(true)
  workspace     Workspace? @relation("WorkspaceCouncils", fields: [workspaceId], references: [id])
  workspaceId   String?
  project       Project? @relation("ProjectCouncils", fields: [projectId], references: [id])
  projectId     String?
  members       CouncilMember[] @relation("CouncilMembers")
  sessions      CouncilSession[] @relation("CouncilSessions")
}

model CouncilMember {
  id            String   @id @default(uuid())
  council       Council @relation("CouncilMembers", fields: [councilId], references: [id])
  councilId     String
  persona       Persona @relation("CouncilMemberPersona", fields: [personaId], references: [id])
  personaId     String
  membershipType String   // permanent or rotating
  joinedAt      DateTime @default(now())
  leftAt        DateTime?
  role          String?  // e.g., chair, secretary, member
  active        Boolean  @default(true)
  councilId     String
  personaId     String
}

model CouncilSession {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  council       Council @relation("CouncilSessions", fields: [councilId], references: [id])
  councilId     String
  topic         String
  briefing      String?
  startedAt     DateTime
  endedAt       DateTime?
  status        String   // scheduled, in_progress, completed, cancelled
  artifactId    String?  // references Artifact.id (the session record)
  decisionId    String?  // references Decision.id (if a decision was made)
  artifact      Artifact? @relation("CouncilSessionArtifact", fields: [artifactId], references: [id])
  decision      Decision? @relation("CouncilSessionDecision", fields: [decisionId], references: [id])
  positions     CouncilPosition[] @relation("CouncilSessionPositions")
}

model CouncilPosition {
  id            String   @id @default(uuid())
  session       CouncilSession @relation("CouncilSessionPositions", fields: [sessionId], references: [id])
  sessionId     String
  persona       Persona @relation("CouncilPositionPersona", fields: [personaId], references: [id])
  personaId     String
  position      String   // the persona's stance or argument
  evidence      String   // supporting evidence for position
  changedMind   Boolean  @default(false)
  sessionId     String
  personaId     String
}

model Decision {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project @relation("ProjectDecisions", fields: [projectId], references: [id])
  projectId     String
  title         String
  statement     String   // what was decided
  rationale     String   // why it was decided
  evidence      String   // supporting evidence
  participants  User[] @relation("DecisionParticipants")
  approval      Approval? @relation("DecisionApproval", fields: [approvalId], references: [id])
  approvalId    String?  // references Approval.id
  supersedes    String?  // references Decision.id (the decision this supersedes)
  resultingTasks Task[] @relation("DecisionTasks")
  workspace     Workspace? @relation("WorkspaceDecisions", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Objective {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  title         String
  description   String?
  projectId     String?  // references Project.id
  project       Project? @relation("ProjectObjectives", fields: [projectId], references: [id])
  tasks         Task[] @relation("ObjectiveTasks")
}

model Task {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project @relation("ProjectTasks", fields: [projectId], references: [id])
  projectId     String
  objective     Objective? @relation("ObjectiveTasks", fields: [objectiveId], references: [id])
  objectiveId   String?
  title         String
  description   String?
  status        TaskStatus @default(BACKLOG)
  priority      Int @default(1) // 1-5 scale
  assignee      User? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId    String?
  personaId     String?  // references Persona.id assigned to this task
  deadline      DateTime?
  artifacts     Artifact[] @relation("TaskArtifacts")
  dependencies  TaskDependency[] @relation("TaskDependencies")
  executionHistory ExecutionHistory[] @relation("TaskExecutionHistory")
  workspace     Workspace? @relation("WorkspaceTasks", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model TaskDependency {
  id            String   @id @default(uuid())
  task          Task @relation("TaskDependencies", fields: [taskId], references: [id])
  taskId        String
  dependsOnTask Task @relation("DependencyOfTask", fields: [dependsOnTaskId], references: [id])
  dependsOnTaskId String
  // dependency type: blocked_by, related_to, duplicates
  type          String @default("blocked_by")
  task          Task
  taskId        String
  dependsOnTask Task
  dependsOnTaskId String
}

model ExecutionHistory {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  task          Task @relation("TaskExecutionHistory", fields: [taskId], references: [id])
  taskId        String
  status        String   // started, paused, resumed, completed, failed
  details       String?
  performer     String   // user, orion, persona name
  performerType String   // user, orion, persona
}

model Action {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  title         String
  description   String?
  operation     String   // e.g., "create_file", "edit_file", "update_project"
  target        String   // what the action targets (e.g., file path, project ID)
  scope         String   // scope of action (e.g., "file", "project", "workspace")
  reason        String   // why the action is proposed
  expectedOutcome String
  risk          String   // potential risks
  reversible    Boolean  @default(false)
  evidence      String   // supporting evidence for need
  proposal      Proposal? @relation("ActionProposal", fields: [proposalId], references: [id])
  proposalId    String?  // references Proposal.id
  approval      Approval? @relation("ActionApproval", fields: [approvalId], references: [id])
  approvalId    String?  // references Approval.id
  artifact      Artifact? @relation("ActionArtifact", fields: [artifactId], references: [id])
  artifactId    String?  // references Artifact.id
  workspace     Workspace? @relation("WorkspaceActions", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Proposal {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  requestedBy   User @relation("ProposalRequester", fields: [requestedById], references: [id])
  requestedById String
  target        String   // e.g., "project.drop-002", "file.vault/planning.md"
  operation     String   // e.g., "create", "edit", "delete", "run_analysis"
  reason        String   // why this proposal is made
  scope         String   // e.g., "file", "project", "workspace"
  riskLevel     String   // low, medium, high
  reversible    Boolean  @default(false)
  expiresAt     DateTime?
  status        ProposalStatus @default(DRAFT)
  evidence      String   // supporting evidence
  approval      Approval? @relation("ProposalApproval", fields: [approvalId], references: [id])
  approvalId    String?  // references Approval.id
  workspace     Workspace? @relation("WorkspaceProposals", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Approval {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  proposal      Proposal @relation("ApprovalProposal", fields: [proposalId], references: [id])
  proposalId    String
  user          User @relation("ApprovalUser", fields: [userId], references: [id])
  userId        String
  approvedAt    DateTime?
  expiresAt     DateTime?
  approvedScope String?  // if approval is scoped narrower than proposal
  approvedVersion String?  // version of proposal that was approved
  status        ApprovalStatus @default(PENDING)
  workspace     Workspace? @relation("WorkspaceApprovals", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Artifact {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  type          ArtifactType
  title         String
  locator       String   // file path, URL, etc.
  hashOrVersion String?  // for versioning
  projectId     String?  // references Project.id
  taskId        String?  // references Task.id
  project       Project? @relation("ProjectArtifacts", fields: [projectId], references: [id])
  task          Task?    @relation("TaskArtifacts", fields: [taskId], references: [id])
  workspace     Workspace? @relation("WorkspaceArtifacts", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Event {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  type          String   // e.g., "decision.approved", "task.completed", "file.synced"
  entityType    String   // the type of entity this event relates to (e.g., "decision", "task", "file")
  entityId      String   // the ID of the entity
  actorType     String   // user, orion, persona, system
  actorId       String   // references User.id, orion system, Persona.id, etc.
  data          Json?    // additional event-specific data
  projectId     String?  // references Project.id
  project       Project? @relation("ProjectEvents", fields: [projectId], references: [id])
  workspace     Workspace? @relation("WorkspaceEvents", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Conflict {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  entity        String   // e.g., "project.drop-002", "file.vault/planning.md"
  sourceA       String   // first conflicting source (e.g., "user_edit", "orion_proposal")
  sourceB       String   // second conflicting source
  state         ConflictState @default(DETECTED)
  detectedAt    DateTime @default(now())
  resolution    String?  // how the conflict was resolved (if resolved)
  resolvedAt    DateTime?
  resolvedBy    String?  // who resolved it (user id, orion, etc.)
  workspace     Workspace? @relation("WorkspaceConflicts", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Notification {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  type          String   // e.g., "approval_needed", "task_finished", "task_failed", "important_observation"
  title         String
  message       String
  relatedEntityType String? // e.g., "proposal", "task", "decision"
  relatedEntityId String?   // references the entity ID
  user          User @relation("NotificationUser", fields: [userId], references: [id])
  userId        String
  workspace     Workspace? @relation("WorkspaceNotifications", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Automation {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  title         String
  description   String?
  trigger       String   // e.g., "cron:0 9 * * MON-FRI", "event:task.completed"
  action        String   // what the automation does (e.g., "review_unfinished_projects")
  isActive      Boolean  @default(true)
  lastRun       DateTime?
  nextRun       DateTime?
  workspace     Workspace? @relation("WorkspaceAutomations", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Tool {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String   // e.g., "file_reader", "web_search", "code_executor"
  description   String
  inputSchema   Json?    // JSON Schema for tool input
  outputSchema  Json?    // JSON Schema for tool output
  permission    String   // e.g., "READ", "ANALYZE", "PROPOSE", "LOCAL_WRITE", "DESTRUCTIVE", "EXTERNAL_MESSAGE", "FINANCIAL", "SYSTEM"
  isEnabled     Boolean  @default(true)
  workspace     Workspace? @relation("WorkspaceTools", fields: [workspaceId], references: [id])
  workspaceId   String?
}

model Permission {
  id            String   @id @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  name          String   // e.g., "FILE_READ_PROJECT_X", "WEB_SEARCH_ALLOWED"
  description   String?
  resource      String   // e.g., "project.drop-002", "vault:/financials", "web:*"
  operation     String   // e.g., "READ", "WRITE", "DELETE", "EXECUTE"
  grantedTo     String   // e.g., "user", "role:admin", "agent:file_manager"
  grantedBy     User @relation("PermissionGrantedBy", fields: [grantedById], references: [id])
  grantedById   String
  grantedAt     DateTime @default(now())
  expiresAt     DateTime?
  workspace     Workspace? @relation("WorkspacePermissions", fields: [workspaceId], references: [id])
  workspaceId   String?
}